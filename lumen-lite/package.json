{
  "name": "lumen-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:daemon": "bun run --filter @lumen/daemon dev",
    "dev:ui": "bun run --filter @lumen/ui dev",
    "dev": "bun run --filter \"@lumen/*\" --parallel dev",
    "build": "bun run --filter \"@lumen/*\" build",
    "test": "bun test",
    "check": "bun x tsc --build",
    "lint": "bun x eslint packages/ slices/ apps/",
    "lint:docs": "bun x eslint packages/ slices/ apps/ --rule 'jsdoc/require-jsdoc: error'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "zod": "3.24.2"
  }
}
