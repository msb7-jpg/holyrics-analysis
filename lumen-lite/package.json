{
  "name": "lumen-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:daemon": "bun run --filter @lumen/daemon dev",
    "dev:ui": "bun run --filter @lumen/ui dev",
    "dev": "bun run --filter \"@lumen/*\" --parallel dev",
    "build": "bun run --filter \"@lumen/*\" build",
    "test": "bun test",
    "check": "bun x tsc --noEmit",
    "lint": "bun x eslint packages/ slices/ apps/",
    "lint:docs": "bun x eslint packages/ slices/ apps/ --rule 'jsdoc/require-jsdoc: error'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.13.0",
    "@types/pino": "^7.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@siberiacancode/reactuse": "^1.0.17",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^0.475.0",
    "pino": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  }
}
